{
  "entities": {
    "Idea": {
      "title": "Idea",
      "description": "An opportunity or business idea tracked by a user",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "tag": { "type": "string" },
        "priority": { "type": "string" },
        "status": { "type": "string" },
        "opportunityScore": { "type": "number" },
        "feasibilityScore": { "type": "number" },
        "timingScore": { "type": "number" },
        "userId": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "name", "userId"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile and preferences",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User profile document"
    },
    "/users/{userId}/ideas/{ideaId}": {
      "schema": "Idea",
      "description": "User ideas collection"
    }
  }
}
